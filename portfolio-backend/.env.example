# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Database
# For local SQLite development:
DATABASE_URL=sqlite:///portfolio.db
# For Railway MySQL (note: Railway provides mysql://, we'll convert to mysql+pymysql://):
DATABASE_URL=mysql+pymysql://user:password@db.railway.internal:3306/railway
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost/portfolio_db

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Server Configuration
FLASK_PORT=5000
